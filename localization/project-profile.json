{
  "schema_version": 1,
  "game": {
    "name": "Psycholog",
    "build": "Psycholog.exe Windows x64 build (Unity 2021.3.7f1, Mono)",
    "unity_version": "2021.3.7f1",
    "scripting_backend": "Mono",
    "architecture": "x64",
    "textmeshpro_version": "3.0"
  },
  "sources": {
    "managed": "resources/Assembly-CSharp-decompiled",
    "exported_resource_types": [
      "resources/AnimationClip",
      "resources/Animator",
      "resources/AnimatorController",
      "resources/AudioClip",
      "resources/AudioSource",
      "resources/Font",
      "resources/GameObject",
      "resources/MonoBehaviour",
      "resources/RectTransform",
      "resources/Sprite",
      "resources/Texture2D",
      "resources/Transform"
    ],
    "work_entries": "resources/work/entries.jsonl",
    "hashes": {
      "algorithm": "sha256",
      "manifest": "resources/work/source-manifest.sha256"
    },
    "adapter": {
      "command": "python scripts/extract_game_text.py",
      "version": "verified against the current extraction outputs"
    }
  },
  "paratranz": {
    "encoding": "utf-8",
    "columns": ["key", "original", "translation"],
    "approved_categories": [
      "dialogue",
      "choice",
      "item",
      "character_name",
      "client_info",
      "ending",
      "ui",
      "image"
    ],
    "module_mapping": {
      "dialogue": "story-dialogue",
      "choice": "choices",
      "item": "items",
      "character_name": "system",
      "client_info": "system",
      "ending": "story-dialogue",
      "ui": "ui",
      "image": "images"
    },
    "export_plan": {
      "status": "planned",
      "implemented": false,
      "command": "python scripts/export_paratranz.py --profile localization/project-profile.json --entries resources/work/entries.jsonl --output resources/work/paratranz",
      "note": "No export script is tracked in this repo yet."
    },
    "import_plan": {
      "status": "planned",
      "implemented": false,
      "command": "python scripts/import_paratranz.py --profile localization/project-profile.json --input resources/work/paratranz-returned --output resources/work/approved-translations.json",
      "note": "No import script is tracked in this repo yet."
    }
  },
  "runtime": {
    "bepinex_version": "BepInEx 5 stable Mono x64",
    "patch_entry_points": [
      "verify a native localization or data seam first",
      "otherwise verify a stable controller or display seam"
    ],
    "AuditMode": "Disabled",
    "adapter_entry": "Plugin.ConfigureGameAdapters",
    "fallback": "preserve original text and assets"
  },
  "fonts": {
    "strategy": "runtime-ttf",
    "source_font": "resources/fonts/南西油墨宋.ttf",
    "character_file": "resources/work/font-characters.txt",
    "plugin_relative_path": "fonts/南西油墨宋.ttf",
    "mappings": {
      "Adler": "fonts/南西油墨宋.ttf",
      "Typewriter_standard": "fonts/朝華打字機.ttf",
      "GochiHand-Regular": "fonts/JasonHandwriting1-Regular.ttf"
    },
    "mapping_source_fonts": [
      "resources/fonts/南西油墨宋.ttf",
      "resources/fonts/朝華打字機.ttf",
      "resources/fonts/JasonHandwriting1-Regular.ttf"
    ],
    "runtime_api_evidence": {
      "unity_font_constructor": "UnityEngine.Font(string name) loads a font from a file path",
      "tmp_create_font_asset": "TMPro.TMP_FontAsset.CreateFontAsset(Font font, int samplingPointSize, int atlasPadding, GlyphRenderMode renderMode, int atlasWidth, int atlasHeight, AtlasPopulationMode atlasPopulationMode, bool enableMultiAtlasSupport)",
      "target_assembly": "D:/SteamLibrary/steamapps/common/Psycholog/Psycholog_Data/Managed/Unity.TextMeshPro.dll"
    },
    "license": "User-provided 南西油墨宋 font copied from the existing BepInEx plugins/fonts directory; redistribution license has not been independently verified."
  },
  "images": {
    "strategy": "human-confirmed targeted replacement",
    "static_index": "resources/work/assetstudio-image-index.jsonl",
    "development_hotkey": "configure per game; no universal default",
    "correlation_fields": [
      "resource_name_and_type",
      "dimensions",
      "path_id",
      "sprite_rect",
      "pixel_hash"
    ],
    "replacement_requires_human_correlation": true
  },
  "qa": {
    "automated_checks": [
      "project validation",
      "adapter tests",
      "Paratranz import validation",
      "plugin build and package inspection"
    ],
    "required_manual_routes": [
      "menus and settings",
      "save and load",
      "critical story and choice branches",
      "failure routes and endings",
      "plugin-disabled original behavior"
    ],
    "release_gate": {
      "maximum_p0_findings": 0,
      "maximum_p1_findings": 0,
      "human_sign_off_required": true
    }
  }
}
